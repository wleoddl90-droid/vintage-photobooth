    </div>
  </section>
</main>
<div class="toast" id="toast" role="status"></div>

<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  // ---- 설정값 ----
  const LEAD = 3;        // 첫 컷까지(초)
  const INTERVAL = 2;    // 컷 사이 간격(초)
  const CELL_AR = 0.8;   // 사진 한 컷 가로:세로 = 4:5
  const PAPER = '#f2eee3';
  // strips = 세로 줄 수, per = 한 줄에 들어가는 컷 수, cw = 한 컷 가로 픽셀(고해상도 저장)
  const LAYOUTS = {
    4: { strips: 1, per: 4, cw: 800 },
    6: { strips: 2, per: 3, cw: 640 },
    9: { strips: 3, per: 3, cw: 520 }
  };
  const A4 = { w: 1654, h: 2339 }; // 200dpi
  const BGS = [
    { name: '아이보리',   type: 'solid',   fill: '#eee8da', ink: '#26231e', swatch: '#eee8da' },
    { name: '블랙 필름',  type: 'film',    fill: '#0d0d0c', ink: '#ece6d8', hole: '#ece6d8', swatch: '#0d0d0c' },
    { name: '버터',       type: 'solid',   fill: '#f6e6a0', ink: '#3a3118', swatch: '#f6e6a0' },
    { name: '베이비블루', type: 'solid',   fill: '#bcd6f3', ink: '#1f3350', swatch: '#bcd6f3' },
    { name: '라벤더',     type: 'solid',   fill: '#d3c5f0', ink: '#34285a', swatch: '#d3c5f0' },
    { name: '소프트핑크', type: 'solid',   fill: '#f6c7d3', ink: '#5a1f31', swatch: '#f6c7d3' },
    { name: '세이지',     type: 'solid',   fill: '#b9c6a5', ink: '#243019', swatch: '#b9c6a5' },
    { name: '체리',       type: 'solid',   fill: '#a3121f', ink: '#fff0e2', swatch: '#a3121f' },
    { name: '모눈',       type: 'grid',    fill: '#f4f3ee', line: '#c9d4e4', ink: '#2a3550',
      swatch: 'linear-gradient(#c9d4e4 1px,transparent 1px) 0 0/9px 9px,linear-gradient(90deg,#c9d4e4 1px,transparent 1px) 0 0/9px 9px,#f4f3ee' },
    { name: '체커',       type: 'checker', a: '#111', b: '#f2f2f2', ink: '#111', plate: '#f2f2f2',
      swatch: 'repeating-conic-gradient(#111 0 25%,#f2f2f2 0 50%) 0 0/16px 16px' },
    { name: '도트',       type: 'dots',    fill: '#f1eadf', dot: '#d8c7ad', ink: '#3a3126',
      swatch: 'radial-gradient(#d8c7ad 28%,transparent 30%) 0 0/10px 10px,#f1eadf' },
    { name: '오로라',     type: 'aurora',  fill: '#f2edfb', ink: '#2b2540',
      swatch: 'radial-gradient(circle at 25% 30%,#ffc2d4,transparent 60%),radial-gradient(circle at 75% 70%,#bcd2ff,transparent 60%),#f2edfb' }
  ];

  // PARISIAN SOFT CONTRAST 기본값: 중간~조금 높은 대비, 은은한 그레인, 따뜻한 크림톤, 아주 약한 피부 보정
  const DEFAULTS = { contrast: .5, brightness: 0, grain: .4, hisoft: .5, skin: .4, warm: .45 };
  const ADJ = [
    ['contrast',   'Contrast',            0, 1],
    ['brightness', 'Brightness',         -1, 1],
    ['grain',      'Film Grain',          0, 1],
    ['hisoft',     'Highlight Softness',  0, 1],
    ['skin',       'Skin Smoothing',      0, 1],
    ['warm',       'Vintage Warmth',      0, 1]
  ];
  const FACE_LIFT = { off: 0, soft: .10, bright: .15 }; // 얼굴 중간톤 밝기 보정량(10~15%)

  // bg: 0 = 사진만(A4 없음), 1.. = BGS[bg-1]
  const state = {
    n: 4, flash: 'soft', skinOn: true, parisian: true, adj: { ...DEFAULTS },
    bg: 0, facing: 'user', stream: null, phase: 'idle', runId: 0, wl: null,
    shots: [], raws: [], pars: [], cache: {}
  };

  const intro = $('#intro'), scene = $('#scene'), shootSec = $('#shoot'), resultSec = $('#result');
  const stage = $('#stage'), cam = $('#cam'), viewCanvas = $('#view'), countEl = $('#count'), flashEl = $('#flash');
  const lamp = $('#lamp'), wall = $('#wall'), recEl = $('#rec'), notice = $('#notice'), slotsEl = $('#slots');
  const startBtn = $('#startBtn'), flipBtn = $('#flipBtn'), out = $('#out');
  const footerText = $('#footerText'), footerField = $('#footerField'), toastEl = $('#toast'), bgHint = $('#bgHint');

  const sleep = ms => new Promise(r => setTimeout(r, ms));
  function toast(msg, ms = 3600) {
    toastEl.textContent = msg; toastEl.classList.add('show');
    clearTimeout(toast.t); toast.t = setTimeout(() => toastEl.classList.remove('show'), ms);
  }
  const showNotice = msg => { notice.textContent = msg; notice.hidden = !msg; };

  // 진짜 부스 사진 배경(선택): 같은 폴더에 booth.jpg 가 있으면 사용
  (function () {
    const im = new Image();
    im.onload = () => { $('#scenePhoto').style.backgroundImage = 'url(booth.jpg)'; scene.classList.add('hasphoto'); };
    im.src = 'booth.jpg';
  })();

  // ---- 소리 ----
  let actx = null;
  function unlockAudio() { try { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') actx.resume(); } catch (e) {} }
  function shutter() {
    if (!actx) return;
    try {
      const len = Math.floor(actx.sampleRate * 0.12), buf = actx.createBuffer(1, len, actx.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3);
      const src = actx.createBufferSource(); src.buffer = buf;
      const f = actx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 1500;
      const gn = actx.createGain(); gn.gain.value = 0.8;
      src.connect(f); f.connect(gn); gn.connect(actx.destination); src.start();
    } catch (e) {}
  }
  function tick() {
    if (!actx) return;
    try { const o = actx.createOscillator(), gn = actx.createGain(); o.frequency.value = 880; gn.gain.value = 0.05; o.connect(gn); gn.connect(actx.destination); o.start(); o.stop(actx.currentTime + 0.05); } catch (e) {}
  }

  // =====================================================================
  //  이미지 처리 파이프라인 (WebGL 셰이더)
  //  라이브 프리뷰와 저장 사진이 똑같은 셰이더·똑같은 파라미터를 쓴다.
  //  순서: 피부 마스크 → 에지 보존 피부 보정 → 얼굴 중간톤 밝기 → 빈티지 흑백(PARISIAN SOFT CONTRAST)
  //  얼굴 모양은 건드리지 않고, 색·밝기만 바꾼다. 생성형 AI는 쓰지 않는다.
  // =====================================================================
  const VS = 'attribute vec2 p;varying vec2 vUv;void main(){vUv=p*.5+.5;gl_Position=vec4(p,0.,1.);}';
  const FS = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform sampler2D uTex;
uniform vec4 uCrop;
uniform float uMirror, uAspect;
uniform float uBW, uContrast, uBright, uGrain, uHiSoft, uSkin, uWarm, uFace, uSeed;
varying vec2 vUv;

vec2 tuv(vec2 uv){
  uv = clamp(uv, 0.0, 1.0);
  if (uMirror > 0.5) uv.x = 1.0 - uv.x;
  return uCrop.xy + uv * uCrop.zw;
}
vec3 S(vec2 uv){ return texture2D(uTex, tuv(uv)).rgb; }
float lum(vec3 c){ return dot(c, vec3(0.299, 0.587, 0.114)); }
float pan(vec3 c){ return dot(c, vec3(0.34, 0.52, 0.14)); }
float hash(vec2 p){
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}
float vnoise(vec2 p){
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
// 화면 높이를 1로 본 반지름 rad 안의 샘플 위치(해상도와 상관없이 같은 크기)
vec2 ring(float i, float n, float rad){
  float a = i * 2.39996;
  float r = sqrt((i + 0.5) / n) * rad;
  return vec2(cos(a) / uAspect, sin(a)) * r;
}
// 피부색 가능성 (머리카락·검은 옷·눈·입술은 낮게 나온다)
float skinLike(vec3 c){
  float y = lum(c);
  float cb = -0.168736 * c.r - 0.331264 * c.g + 0.5 * c.b;
  float cr = 0.5 * c.r - 0.418688 * c.g - 0.081312 * c.b;
  float m = smoothstep(-0.23, -0.17, cb) * (1.0 - smoothstep(-0.03, 0.0, cb));
  m *= smoothstep(0.01, 0.045, cr) * (1.0 - smoothstep(0.15, 0.19, cr));
  m *= smoothstep(0.10, 0.30, y) * (1.0 - smoothstep(0.94, 1.0, y));
  m *= smoothstep(0.0, 0.04, c.r - c.g);
  return m;
}

void main(){
  vec2 uv = vUv;
  vec3 c = S(uv);

  // 1) 피부 영역을 부드럽게 퍼뜨린 마스크 → 경계에 밝은 테두리가 생기지 않는다
  float acc = skinLike(c) * 2.0, wsum = 2.0;
  for (int i = 0; i < 6; i++){ acc += skinLike(S(uv + ring(float(i), 6.0, 0.012))); wsum += 1.0; }
  float m = smoothstep(0.2, 0.85, acc / wsum);

  // 2) 에지 보존(바이래터럴) 피부 보정: 밝기 차가 작은 잡티·결만 부드럽게, 눈·눈썹·윤곽은 그대로
  float lc = lum(c);
  vec3 sum = c; float ws = 1.0;
  for (int i = 0; i < 12; i++){
    vec3 s = S(uv + ring(float(i), 12.0, 0.0055));
    float d = lum(s) - lc;
    float w = exp(-d * d / 0.005);
    sum += s * w; ws += w;
  }
  c = mix(c, sum / ws, clamp(uSkin * m, 0.0, 1.0));

  // 3) 얼굴 중간톤 밝기: 피부 영역에서만 감마로 밝힘 (검정과 흰색은 그대로, 머리·검은 옷은 영향 없음)
  float g = 1.0 - uFace * 1.36 * m;
  c = pow(max(c, vec3(0.0001)), vec3(g));

  vec3 o = c;
  if (uBW > 0.5){
    // 4) PARISIAN SOFT CONTRAST
    float L = pan(c);
    float ls = 0.0;
    for (int i = 0; i < 6; i++) ls += pan(S(uv + ring(float(i), 6.0, 0.0035)));
    L = mix(L, ls / 6.0, 0.28);                       // 디지털 선명함을 살짝 눌러줌
    float lb = 0.0;
    for (int i = 0; i < 6; i++) lb += pan(S(uv + ring(float(i), 6.0, 0.028)));
    L += max(0.0, lb / 6.0 - 0.6) * 0.5 * uHiSoft;    // 하이라이트 블룸
    L += uBright * 0.18;
    float k = 2.2 + uContrast * 4.0;                  // 중간~조금 높은 대비의 S커브
    float y0 = 1.0 / (1.0 + exp(k * 0.5)), y1 = 1.0 / (1.0 + exp(-k * 0.5));
    L = (1.0 / (1.0 + exp(-k * (L - 0.5))) - y0) / (y1 - y0);
    L = 0.03 + L * 0.94;                              // 깊지만 뭉개지지 않는 블랙
    float sh = smoothstep(0.72, 1.0, L);
    L -= sh * (L - 0.72) * uHiSoft * 0.3;             // 부드럽게 눌린 하이라이트
    L = clamp(L, 0.0, 1.0);
    vec3 tint = mix(vec3(1.0), vec3(1.0, 0.955, 0.87), uWarm);   // 크림빛 따뜻한 흑백
    o = vec3(L) * tint + (1.0 - L) * uWarm * vec3(0.010, 0.004, 0.0);
    // 은은한 비네팅 + 필름 그레인 + 아주 약한 톤 얼룩
    float vg = smoothstep(0.45, 1.2, length((uv - 0.5) * vec2(1.0, 1.12) * 1.45));
    o *= 1.0 - 0.12 * vg;
    float n1 = hash(floor(uv * vec2(720.0, 900.0)) + uSeed * 13.7) - 0.5;
    float n2 = hash(floor(uv * vec2(360.0, 450.0)) + uSeed * 7.3 + 31.0) - 0.5;
    float mid = 0.5 + 0.9 * (1.0 - abs(L * 2.0 - 1.0));
    o += (n1 * 0.75 + n2 * 0.5) * uGrain * 0.2 * mid;
    o *= 1.0 + (vnoise(uv * vec2(3.0, 3.7) + uSeed) - 0.5) * 0.035;
  }
  gl_FragColor = vec4(clamp(o, 0.0, 1.0), 1.0);
}`;

  function makePipe(canvas, keep) {
    let gl = null;
    try { gl = canvas.getContext('webgl', { alpha: false, antialias: false, preserveDrawingBuffer: !!keep, premultipliedAlpha: false }); } catch (e) {}
    if (!gl) return null;
    const mk = (type, src) => {
      const sh = gl.createShader(type); gl.shaderSource(sh, src); gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) { console.error(gl.getShaderInfoLog(sh)); return null; }
      return sh;
    };
    const vs = mk(gl.VERTEX_SHADER, VS), fs = mk(gl.FRAGMENT_SHADER, FS);
    if (!vs || !fs) return null;
    const pr = gl.createProgram(); gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) { console.error(gl.getProgramInfoLog(pr)); return null; }
    gl.useProgram(pr);
    const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    const U = {};
    ['uTex', 'uCrop', 'uMirror', 'uAspect', 'uBW', 'uContrast', 'uBright', 'uGrain', 'uHiSoft', 'uSkin', 'uWarm', 'uFace', 'uSeed']
      .forEach(n => { U[n] = gl.getUniformLocation(pr, n); });
    return {
      draw(src, prm, crop, mirror, W, H) {
        if (canvas.width !== W) canvas.width = W;
        if (canvas.height !== H) canvas.height = H;
        gl.viewport(0, 0, W, H);
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, src);
        gl.uniform1i(U.uTex, 0);
        gl.uniform4f(U.uCrop, crop.x, crop.y, crop.w, crop.h);
        gl.uniform1f(U.uMirror, mirror ? 1 : 0);
        gl.uniform1f(U.uAspect, W / H);
        gl.uniform1f(U.uBW, prm.bw); gl.uniform1f(U.uContrast, prm.contrast); gl.uniform1f(U.uBright, prm.bright);
        gl.uniform1f(U.uGrain, prm.grain); gl.uniform1f(U.uHiSoft, prm.hisoft); gl.uniform1f(U.uSkin, prm.skin);
        gl.uniform1f(U.uWarm, prm.warm); gl.uniform1f(U.uFace, prm.face); gl.uniform1f(U.uSeed, prm.seed);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      }
    };
  }

  const VIEW_W = 600, VIEW_H = 750;
  viewCanvas.width = VIEW_W; viewCanvas.height = VIEW_H;
  const viewPipe = makePipe(viewCanvas, false);
  const capCanvas = document.createElement('canvas');
  const capPipe = makePipe(capCanvas, true);
  const glOK = !!(viewPipe && capPipe);
  if (!glOK) stage.classList.add('nogl');

  // 현재 설정을 셰이더 파라미터로 변환 (프리뷰와 저장 사진이 같은 값을 쓴다)
  function params(over) {
    const a = state.adj;
    return Object.assign({
      bw: state.parisian ? 1 : 0,
      contrast: a.contrast, bright: a.brightness, grain: a.grain, hisoft: a.hisoft,
      skin: state.skinOn ? a.skin * 0.8 : 0,
      warm: a.warm,
      face: FACE_LIFT[state.flash],
      seed: 0
    }, over || {});
  }
  function cropFor(vw, vh) {
    const ar = vw / vh;
    if (ar > CELL_AR) { const fw = CELL_AR / ar; return { x: (1 - fw) / 2, y: 0, w: fw, h: 1 }; }
    const fh = ar / CELL_AR; return { x: 0, y: (1 - fh) / 2, w: 1, h: fh };
  }
  const FULL = { x: 0, y: 0, w: 1, h: 1 };

  // 라이브 프리뷰 루프
  function loop(t) {
    requestAnimationFrame(loop);
    if (!glOK || !state.stream || shootSec.hidden || cam.readyState < 2 || !cam.videoWidth) return;
    viewPipe.draw(cam, params({ seed: Math.floor(t / 90) % 97 }), cropFor(cam.videoWidth, cam.videoHeight), state.facing === 'user', VIEW_W, VIEW_H);
  }
  requestAnimationFrame(loop);

  // 카메라 프레임을 보정 없이 한 컷 크기로 잘라 둔다(원본)
  function captureRaw() {
    const L = LAYOUTS[state.n], cw = L.cw, ch = Math.round(cw / CELL_AR);
    const vw = cam.videoWidth, vh = cam.videoHeight, cr = cropFor(vw, vh);
    const c = document.createElement('canvas'); c.width = cw; c.height = ch;
    const g = c.getContext('2d');
    if (state.facing === 'user') { g.translate(cw, 0); g.scale(-1, 1); }
    g.imageSmoothingQuality = 'high';
    if (!glOK && state.parisian && 'filter' in g) g.filter = 'grayscale(1) contrast(1.3) brightness(1.08) sepia(.3)';
    g.drawImage(cam, cr.x * vw, cr.y * vh, cr.w * vw, cr.h * vh, 0, 0, cw, ch);
    return c;
  }
  // 프리뷰와 같은 셰이더로 원본을 처리해 저장용 이미지를 만든다
  function finalize(raw, prm) {
    if (!glOK) return raw;
    capPipe.draw(raw, prm, FULL, false, raw.width, raw.height);
    const c = document.createElement('canvas'); c.width = raw.width; c.height = raw.height;
    c.getContext('2d').drawImage(capCanvas, 0, 0);
    return c;
  }

  // ---- 설정 UI ----
  function renderSlots() {
    slotsEl.innerHTML = '';
    for (let i = 0; i < state.n; i++) {
      const s = document.createElement('div'); s.className = 'slot';
      if (state.shots[i]) {
        const c = document.createElement('canvas'); c.width = 100; c.height = Math.round(100 / CELL_AR);
        c.getContext('2d').drawImage(state.shots[i], 0, 0, c.width, c.height);
        s.appendChild(c); s.classList.add('full');
      }
      slotsEl.appendChild(s);
    }
  }
  function resetShots() { state.shots = []; state.raws = []; state.pars = []; state.cache = {}; }
  function setN(n) {
    if (state.phase === 'shooting') return;
    state.n = n; resetShots();
    $$('#segN button').forEach(b => b.setAttribute('aria-pressed', String(+b.dataset.n === n)));
    renderSlots();
  }
  function setFlash(v) {
    state.flash = v; wall.dataset.flash = v;
    $$('#segFlash button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.flash === v)));
  }
  function setSkin(on) {
    state.skinOn = on;
    $$('#segSkin button').forEach(b => b.setAttribute('aria-pressed', String((b.dataset.skin === 'natural') === on)));
  }
  function setParisian(on) {
    state.parisian = on;
    $$('[data-par]').forEach(b => b.setAttribute('aria-pressed', String((b.dataset.par === 'on') === on)));
    if (!resultSec.hidden) render();
  }
  function setPhase(p) {
    state.phase = p;
    const shooting = p === 'shooting';
    startBtn.textContent = shooting ? '취소' : '촬영 시작';
    flipBtn.disabled = shooting;
    $$('#segN button').forEach(b => b.disabled = shooting);
    recEl.hidden = !shooting;
    if (!shooting) countEl.textContent = '';
  }

  // 세부 조절 슬라이더
  const adjBox = $('#adjBox');
  ADJ.forEach(([key, label, min, max]) => {
    const row = document.createElement('div'); row.className = 'adjrow';
    row.innerHTML = `<label for="adj-${key}">${label}</label><input id="adj-${key}" type="range" min="${min}" max="${max}" step="0.01" value="${state.adj[key]}">`;
    row.querySelector('input').addEventListener('input', e => { state.adj[key] = +e.target.value; });
    adjBox.appendChild(row);
  });
  $('#adjReset').addEventListener('click', () => {
    state.adj = { ...DEFAULTS };
    ADJ.forEach(([key]) => { $('#adj-' + key).value = DEFAULTS[key]; });
  });

  // ---- 카메라 ----
  function stopCamera() {
    if (state.stream) state.stream.getTracks().forEach(t => t.stop());
    state.stream = null; cam.srcObject = null;
  }
  async function startCamera() {
    showNotice('');
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showNotice('이 주소에서는 카메라를 켤 수 없어요. https:// 로 시작하는 주소로 열어주세요.');
      return false;
    }
    stopCamera();
    try {
      state.stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: state.facing, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false
      });
      cam.srcObject = state.stream;
      cam.classList.toggle('mirror', state.facing === 'user');
      await cam.play().catch(() => {});
      setPhase('ready');
      return true;
    } catch (e) {
      const denied = e && (e.name === 'NotAllowedError' || e.name === 'SecurityError');
      showNotice(denied
        ? '카메라 권한이 꺼져 있어요. 주소창 옆 자물쇠(설정)에서 카메라를 허용한 뒤 새로고침해 주세요.'
        : '카메라를 켤 수 없어요. 다른 앱이 카메라를 쓰고 있지 않은지 확인해 주세요.');
      return false;
    }
  }
  // 화면이 꺼지거나 어두워지지 않게(허용되는 기기에서만)
  async function keepAwake(on) {
    try {
      if (on && navigator.wakeLock && !state.wl) { state.wl = await navigator.wakeLock.request('screen'); state.wl.addEventListener('release', () => { state.wl = null; }); }
      if (!on && state.wl) { await state.wl.release(); state.wl = null; }
    } catch (e) {}
  }

  // ---- 입장 ----
  async function enter() {
    unlockAudio(); keepAwake(true);
    intro.classList.add('entering');
    const camP = startCamera();
    await sleep(950);
    intro.hidden = true; shootSec.hidden = false; document.body.classList.add('inside');
    window.scrollTo(0, 0);
    await camP;
  }

  // ---- 촬영 ----
  function flash() {
    flashEl.classList.remove('go'); void flashEl.offsetWidth; flashEl.classList.add('go');
    lamp.classList.add('on'); setTimeout(() => lamp.classList.remove('on'), 260);
  }
  async function shoot() {
    unlockAudio();
    if (state.phase === 'shooting') { state.runId++; wall.classList.remove('pulse'); setPhase('ready'); resetShots(); renderSlots(); return; }
    if (!state.stream) { const ok = await startCamera(); if (!ok) return; await sleep(400); }
    const id = ++state.runId;
    resetShots(); renderSlots(); setPhase('shooting'); keepAwake(true);
    for (let i = 0; i < state.n; i++) {
      const secs = i === 0 ? LEAD : INTERVAL;
      for (let s = secs; s >= 1; s--) {
        countEl.textContent = s; tick();
        if (s === 1 && state.flash !== 'off') {
          await sleep(450); if (id !== state.runId) return;
          wall.classList.add('pulse');           // 찍기 직전 화면 조명을 잠깐 최대로
          await sleep(550);
        } else {
          await sleep(1000);
        }
        if (id !== state.runId) { wall.classList.remove('pulse'); return; }
      }
      countEl.textContent = '';
      // 프리뷰와 같은 파이프라인으로 처리 (화면 조명·플래시 애니메이션은 사진에 합성되지 않음)
      const raw = captureRaw(), pr = params({ seed: i * 3 + 1 });
      const done = finalize(raw, pr);
      state.raws.push(raw); state.pars.push(pr); state.shots.push(done);
      (state.cache[pr.bw] = state.cache[pr.bw] || {})[i] = done;
      flash(); shutter();
      setTimeout(() => wall.classList.remove('pulse'), 150);  // 천천히 원래 밝기로
      renderSlots();
    }
    await sleep(700);
    if (id !== state.runId) return;
    setPhase('ready'); stopCamera(); keepAwake(false);
    shootSec.hidden = true; resultSec.hidden = false;
    state.bg = 0; syncBg();
    render();
    window.scrollTo(0, 0);
  }
  function retake() {
    state.runId++; resetShots();
    resultSec.hidden = true; shootSec.hidden = false;
    renderSlots(); setPhase('idle'); keepAwake(true); startCamera();
  }

  function looked(i) {
    const key = state.parisian ? 1 : 0;
    const c = state.cache[key] || (state.cache[key] = {});
    return c[i] || (c[i] = finalize(state.raws[i], Object.assign({}, state.pars[i], { bw: key })));
  }

  // ---- 사진(스트립) 합성: 같은 필터가 네 컷 모두에 적용됨 ----
  function buildSheet() {
    const L = LAYOUTS[state.n], cw = L.cw, ch = Math.round(cw / CELL_AR);
    const m = Math.round(cw * .06), gp = Math.round(cw * .03), sg = Math.round(cw * .06), bottom = Math.round(cw * .1);
    const W = m * 2 + L.strips * cw + (L.strips - 1) * sg;
    const H = m * 2 + L.per * ch + (L.per - 1) * gp + bottom;
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const g = c.getContext('2d');
    g.fillStyle = PAPER; g.fillRect(0, 0, W, H);
    const lw = Math.max(2, Math.round(cw * .004));
    state.shots.forEach((_, i) => {
      const s = Math.floor(i / L.per), r = i % L.per;
      const x = m + s * (cw + sg), y = m + r * (ch + gp);
      g.drawImage(looked(i), x, y);
      g.strokeStyle = 'rgba(24,21,16,.6)'; g.lineWidth = lw;   // 얇은 빈티지 테두리
      g.strokeRect(x - lw / 2, y - lw / 2, cw + lw, ch + lw);
    });
    return c;
  }

  // ---- A4 배경 ----
  function rr(g, x, y, w, h, r) {
    g.beginPath(); g.moveTo(x + r, y); g.arcTo(x + w, y, x + w, y + h, r); g.arcTo(x + w, y + h, x, y + h, r);
    g.arcTo(x, y + h, x, y, r); g.arcTo(x, y, x + w, y, r); g.closePath();
  }
  function drawBg(g, bg, W, H) {
    if (bg.type === 'checker') {
      const s = Math.round(W / 22);
      for (let y = 0; y * s < H; y++) for (let x = 0; x * s < W; x++) { g.fillStyle = (x + y) % 2 ? bg.a : bg.b; g.fillRect(x * s, y * s, s, s); }
      return;
    }
    g.fillStyle = bg.fill; g.fillRect(0, 0, W, H);
    if (bg.type === 'dots') {
      const s = Math.round(W / 24); g.fillStyle = bg.dot;
      for (let y = s / 2; y < H; y += s) for (let x = s / 2; x < W; x += s) { g.beginPath(); g.arc(x, y, s * .13, 0, 7); g.fill(); }
    } else if (bg.type === 'grid') {
      const s = Math.round(W / 30); g.strokeStyle = bg.line; g.lineWidth = 2; g.beginPath();
      for (let x = s; x < W; x += s) { g.moveTo(x, 0); g.lineTo(x, H); }
      for (let y = s; y < H; y += s) { g.moveTo(0, y); g.lineTo(W, y); }
      g.stroke();
    } else if (bg.type === 'aurora') {
      [[.15, .1, '#ffc2d4'], [.9, .28, '#bcd2ff'], [.15, .6, '#ffe7b0'], [.9, .85, '#cdb9ff'], [.4, 1, '#ffc2d4']].forEach(([bx, by, c]) => {
        const r = Math.max(W, H) * .55, gr = g.createRadialGradient(bx * W, by * H, 0, bx * W, by * H, r);
        gr.addColorStop(0, c); gr.addColorStop(1, c + '00'); g.fillStyle = gr; g.fillRect(0, 0, W, H);
      });
    } else if (bg.type === 'film') {
      const pad = W * .05, hw = pad * .45, hh = pad * .62, pitch = pad * 1.2;
      g.fillStyle = bg.hole;
      for (let y = pitch / 2; y < H - hh / 2; y += pitch) {
        rr(g, (pad - hw) / 2, y - hh / 2, hw, hh, hw * .25); g.fill();
        rr(g, W - pad + (pad - hw) / 2, y - hh / 2, hw, hh, hw * .25); g.fill();
      }
    }
  }
  function tape(g, cx, y, w, h, rot) {
    g.save(); g.translate(cx, y); g.rotate(rot);
    g.fillStyle = 'rgba(236,224,184,.82)'; g.fillRect(-w / 2, -h / 2, w, h);
    g.fillStyle = 'rgba(255,255,255,.28)'; for (let x = -w / 2 + 14; x < w / 2; x += 28) g.fillRect(x, -h / 2, 8, h);
    g.restore();
  }

  async function render() {
    if (!state.shots.length) return;
    const sheet = buildSheet();
    if (state.bg === 0) {
      out.width = sheet.width; out.height = sheet.height;
      out.getContext('2d').drawImage(sheet, 0, 0);
      return;
    }
    try { await Promise.all([document.fonts.load('italic 600 40px "Bodoni Moda"'), document.fonts.load('400 20px "DM Mono"')]); } catch (e) {}
    const W = A4.w, H = A4.h, bg = BGS[state.bg - 1];
    out.width = W; out.height = H;
    const g = out.getContext('2d');
    drawBg(g, bg, W, H);

    // 사진을 A4 정중앙에 붙임
    const k = Math.min((W * .7) / sheet.width, (H * .76) / sheet.height);
    const sw = Math.round(sheet.width * k), sh = Math.round(sheet.height * k);
    const sx = Math.round((W - sw) / 2), sy = Math.round((H - sh) / 2);
    g.save(); g.shadowColor = 'rgba(0,0,0,.38)'; g.shadowBlur = 36; g.shadowOffsetY = 14;
    g.imageSmoothingQuality = 'high'; g.drawImage(sheet, sx, sy, sw, sh); g.restore();
    tape(g, sx + sw / 2, sy + 4, Math.min(sw * .38, 230), 62, -.05);

    // 하단 문구 + 날짜
    const now = new Date(), pz = v => String(v).padStart(2, '0');
    const date = `${now.getFullYear()}.${pz(now.getMonth() + 1)}.${pz(now.getDate())}`;
    const text = footerText.value.trim();
    const cyt = (sy + sh + H) / 2;
    const s1 = Math.round(W * .036), s2 = Math.round(W * .016);
    const f1 = `italic 600 ${s1}px "Bodoni Moda","Noto Serif KR",Georgia,serif`;
    const f2 = `400 ${s2}px "DM Mono",ui-monospace,Menlo,monospace`;
    g.textAlign = 'center'; g.textBaseline = 'middle';
    const y1 = text ? cyt - s1 * .3 : cyt, y2 = text ? cyt + s1 * .7 : cyt;
    if (bg.plate) {
      g.font = f1; const w1 = text ? g.measureText(text).width : 0;
      g.font = f2; const w2 = g.measureText(date).width * 1.2;
      const pw = Math.max(w1, w2) + s1 * 1.2, ph = text ? s1 * 2.3 : s2 * 3;
      g.fillStyle = bg.plate; g.fillRect(W / 2 - pw / 2, cyt - ph / 2, pw, ph);
    }
    g.fillStyle = bg.ink;
    if (text) { g.font = f1; g.fillText(text, W / 2, y1); }
    g.font = f2; if ('letterSpacing' in g) g.letterSpacing = Math.round(s2 * .2) + 'px';
    g.fillText(date, W / 2, y2);
    if ('letterSpacing' in g) g.letterSpacing = '0px';
  }

  // ---- 저장 / 공유 ----
  const toBlob = () => new Promise(res => out.toBlob(res, 'image/png'));
  function fileName() {
    const n = new Date(), p = v => String(v).padStart(2, '0');
    return `photobooth-${n.getFullYear()}${p(n.getMonth() + 1)}${p(n.getDate())}-${p(n.getHours())}${p(n.getMinutes())}.png`;
  }
  function download(blob) {
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = fileName();
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  }
  async function save() {
    const blob = await toBlob(); if (!blob) return;
    download(blob); toast('사진을 저장했어요. 다운로드(사진) 폴더를 확인해 주세요.');
  }
  async function shareInstagram() {
    const blob = await toBlob(); if (!blob) return;
    const file = new File([blob], fileName(), { type: 'image/png' });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try { await navigator.share({ files: [file], title: 'Photo Booth' }); return; }
      catch (e) { if (e && e.name === 'AbortError') return; }
    }
    download(blob);
    toast('사진을 저장했어요. 인스타그램에서 방금 저장한 사진을 선택해 올려주세요.', 6000);
    window.open('https://www.instagram.com/', '_blank', 'noopener');
  }

  // ---- 배경 선택 UI ----
  const sw = $('#swatches');
  const swItems = [{ name: '사진만', swatch: 'repeating-conic-gradient(#444 0 25%,#6a6a6a 0 50%) 0 0/10px 10px' }, ...BGS];
  swItems.forEach((b, i) => {
    const el = document.createElement('button'); el.type = 'button'; el.className = 'sw';
    el.innerHTML = `<i style="background:${b.swatch}"></i><span>${b.name}</span>`;
    el.addEventListener('click', () => { state.bg = i; syncBg(); render(); });
    sw.appendChild(el);
  });
  function syncBg() {
    $$('.sw', sw).forEach((x, j) => x.setAttribute('aria-pressed', String(j === state.bg)));
    footerField.hidden = state.bg === 0;
    bgHint.textContent = state.bg === 0 ? '고르지 않으면 사진만 저장·공유돼요.' : 'A4 한 장에 사진을 붙인 모습으로 저장·공유돼요.';
  }

  // ---- 이벤트 ----
  $('#enterBtn').addEventListener('click', enter);
  $$('#segN button').forEach(b => b.addEventListener('click', () => setN(+b.dataset.n)));
  $$('#segFlash button').forEach(b => b.addEventListener('click', () => setFlash(b.dataset.flash)));
  $$('#segSkin button').forEach(b => b.addEventListener('click', () => setSkin(b.dataset.skin === 'natural')));
  $$('[data-par]').forEach(b => b.addEventListener('click', () => setParisian(b.dataset.par === 'on')));
  startBtn.addEventListener('click', shoot);
  flipBtn.addEventListener('click', async () => {
    state.facing = state.facing === 'user' ? 'environment' : 'user';
    if (state.stream) await startCamera(); else cam.classList.toggle('mirror', state.facing === 'user');
  });
  $('#saveBtn').addEventListener('click', save);
  $('#igBtn').addEventListener('click', shareInstagram);
  $('#retakeBtn').addEventListener('click', retake);
  footerText.addEventListener('input', () => { clearTimeout(footerText.t); footerText.t = setTimeout(render, 120); });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && state.phase === 'shooting') { state.runId++; wall.classList.remove('pulse'); setPhase('ready'); resetShots(); renderSlots(); }
    if (!document.hidden && !shootSec.hidden) keepAwake(true);
  });

  renderSlots(); setFlash('soft'); setSkin(true); setParisian(true); setPhase('idle'); syncBg();
  window.__booth = { state, render, params, finalize, glOK, FULL };
})();
</script>
</body>
