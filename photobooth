<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>4컷 포토부스</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@1,6..96,600&family=DM+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  /* 구성: 1) 부스 앞 거리 장면(입장) → 2) 커튼 안쪽에서 촬영 → 3) 결과(사진만 / A4에 붙이기) */
  :root{
    --ink:#0e1513;
    --panel:rgba(12,13,16,.78);
    --line:#3a3a3a;
    --paper:#ece6d8;
    --muted:#aaa395;
    --curtain:#b32a20;
    --curtain-ink:#fff6ea;
    --wall:#d8cba7;
    --wall-ink:#2a241a;
    --display:"Bodoni Moda","Noto Serif KR",Georgia,serif;
    --body:"Noto Sans KR",system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
    --mono:"DM Mono",ui-monospace,Menlo,Consolas,monospace;
    color-scheme:dark;
  }
  *{box-sizing:border-box}
  [hidden]{display:none!important}
  html,body{margin:0}
  body{
    background:var(--ink);color:var(--paper);font-family:var(--body);font-size:15px;line-height:1.5;min-height:100svh;
    padding-block:max(14px,env(safe-area-inset-top)) max(28px,env(safe-area-inset-bottom));
    padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right));
    -webkit-tap-highlight-color:transparent;
  }
  /* 부스 안쪽: 네이비 커튼이 사방을 둘러싼 느낌 */
  body.inside{
    background:
      linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,0) 22%,rgba(0,0,0,0) 70%,rgba(0,0,0,.6)),
      repeating-linear-gradient(90deg,#0f1328 0 12px,#1d2447 12px 24px,#0f1328 24px 38px);
    background-attachment:fixed;
  }
  .app{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
  h1{margin:0;font-family:var(--display);font-style:italic;font-weight:600;font-size:28px;letter-spacing:.01em}
  .sub{margin:0;font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  header{display:flex;align-items:baseline;justify-content:space-between;gap:12px}

  /* ---- 1. 입장 장면 ---- */
  .intro{position:relative;height:min(calc(100svh - 96px),820px);min-height:520px;overflow:hidden;border-radius:3px;background:#141f1c}
  .scene{position:absolute;inset:0;transition:transform 1s cubic-bezier(.6,0,.3,1),opacity .9s ease-in;transform-origin:55% 62%}
  .scene svg,.scene .photo{position:absolute;inset:0;width:100%;height:100%}
  .scene .photo{background-size:cover;background-position:center;display:none}
  .scene.hasphoto .photo{display:block}
  .scene.hasphoto svg{display:none}
  .intro.entering .scene{transform:scale(3.4);opacity:.15}
  .intro::after{content:"";position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 120px rgba(0,0,0,.65)}
  .enter{
    position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:3;appearance:none;border:1px solid rgba(255,246,234,.6);
    background:rgba(10,12,12,.72);color:var(--curtain-ink);padding:14px 22px;min-height:52px;border-radius:2px;font:inherit;font-weight:700;font-size:16px;cursor:pointer;
    white-space:nowrap;backdrop-filter:blur(4px);
  }
  .enter small{display:block;font-weight:400;font-size:12px;color:#d8d0c0}
  .intro.entering .enter{opacity:0;transition:opacity .3s}

  /* ---- 2. 촬영 ---- */
  /* 화면 조명(Screen Fill Light): 카메라 주변을 밝은 흰색으로 채워 얼굴을 비춘다. 사진에는 합성되지 않는다. */
  .wall{
    --pad-x:14px;
    background:var(--wall);padding:6px var(--pad-x) 16px;border-radius:3px;box-shadow:0 14px 44px rgba(0,0,0,.6);color:var(--wall-ink);
    transition:background .9s ease-in-out,box-shadow .9s ease-in-out,padding .3s;
  }
  .wall[data-flash="soft"],.wall[data-flash="bright"]{margin-inline:-16px;border-radius:0}
  .wall[data-flash="soft"]{--pad-x:26px;padding-top:12px;padding-bottom:26px;background:#f3efe6;box-shadow:0 0 60px 10px rgba(255,250,240,.25)}
  .wall[data-flash="bright"]{--pad-x:34px;padding-top:16px;padding-bottom:34px;background:#fdfbf6;box-shadow:0 0 90px 24px rgba(255,255,255,.4)}
  .wall.pulse{background:#fff!important;box-shadow:0 0 140px 50px rgba(255,255,255,.95)!important;transition:background .45s ease-out,box-shadow .45s ease-out}
  .lamp{height:12px;width:62%;margin:0 auto 14px;border-radius:0 0 10px 10px;background:linear-gradient(#fffdf0,#ffe9a6);box-shadow:0 0 26px 6px rgba(255,236,170,.6);transition:box-shadow .08s}
  .lamp.on{box-shadow:0 0 140px 80px rgba(255,255,255,.95)}
  .stage{
    --ar:.8;--maxh:58svh;
    position:relative;width:min(100%,calc(var(--maxh) * var(--ar)));aspect-ratio:var(--ar);margin-inline:auto;
    background:#000;border:9px solid #1f1d1a;border-radius:2px;overflow:hidden;box-shadow:inset 0 0 0 1px #000,0 2px 0 rgba(255,255,255,.35);
  }
  .stage video{position:absolute;left:0;top:0;width:2px;height:2px;opacity:0;pointer-events:none}
  .stage canvas#view{position:absolute;inset:0;width:100%;height:100%;display:block}
  .stage.nogl video{inset:0;width:100%;height:100%;opacity:1;object-fit:cover;filter:grayscale(1) contrast(1.3) brightness(1.08) sepia(.3)}
  .stage.nogl video.mirror{transform:scaleX(-1)}
  .stage.nogl canvas#view{display:none}
  .count{
    position:absolute;inset:0;display:grid;place-items:center;z-index:3;pointer-events:none;
    font-family:var(--display);font-style:italic;font-weight:600;font-size:min(36vw,170px);line-height:1;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,.65);
  }
  .rec{position:absolute;top:10px;left:12px;z-index:3;display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:#fff}
  .rec i{width:8px;height:8px;border-radius:50%;background:var(--curtain);animation:blink 1s steps(2) infinite}
  @keyframes blink{50%{opacity:.15}}
  .notice{position:absolute;left:0;right:0;bottom:0;z-index:5;margin:0;padding:10px 12px;background:rgba(0,0,0,.85);font-size:13px;line-height:1.45;color:var(--paper)}
  .flashfull{position:fixed;inset:0;background:#fff;opacity:0;z-index:60;pointer-events:none}
  .flashfull.go{animation:flash .7s ease-out}
  @keyframes flash{0%{opacity:0}9%{opacity:.62}100%{opacity:0}}
  @keyframes flashsoft{0%{opacity:0}9%{opacity:.2}100%{opacity:0}}

  .slots{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;min-height:50px}
  .slot{--ar:.8;width:38px;aspect-ratio:var(--ar);background:rgba(0,0,0,.45);border:1px dashed #5a5a5a;overflow:hidden}
  .slot canvas{width:100%;height:100%;display:block;filter:var(--look-css,none)}
  .slot.full{border-style:solid;border-color:var(--paper)}

  .panel{display:flex;flex-direction:column;gap:14px;background:var(--panel);border:1px solid var(--line);padding:16px;backdrop-filter:blur(6px)}
  .row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .lab{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .seg{display:flex;border:1px solid var(--line)}
  .seg button{appearance:none;background:transparent;color:var(--paper);border:0;border-right:1px solid var(--line);padding:9px 14px;min-height:40px;font:inherit;font-size:14px;cursor:pointer}
  .seg button:last-child{border-right:0}
  .seg button[aria-pressed="true"]{background:var(--paper);color:var(--ink);font-weight:700}
  .seg button:disabled{opacity:.5;cursor:not-allowed}
  .actions{display:flex;gap:10px;flex-wrap:wrap}
  .btn{appearance:none;flex:1 1 140px;min-height:48px;padding:12px 18px;border:1px solid var(--line);border-radius:2px;background:transparent;color:var(--paper);font:inherit;font-weight:500;cursor:pointer}
  .btn.primary{background:var(--curtain);border-color:var(--curtain);color:var(--curtain-ink);font-weight:700;flex-grow:2}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .btn:active:not(:disabled){transform:translateY(1px)}
  .hint{margin:0;font-size:13px;color:var(--muted)}
  button:focus-visible,input:focus-visible{outline:2px solid var(--paper);outline-offset:2px}

  /* ---- 3. 결과 ---- */
  #result{display:flex;flex-direction:column;gap:16px}
  .print{display:grid;place-items:center;background:rgba(0,0,0,.55);border:1px solid var(--line);padding:16px}
  #out{width:auto;height:auto;max-width:100%;max-height:70svh;display:block;box-shadow:0 10px 30px rgba(0,0,0,.55);
       background:repeating-conic-gradient(#2c2c2c 0 25%,#383838 0 50%) 0 0/16px 16px}
  .swatches{display:flex;gap:10px;overflow-x:auto;padding:4px 2px 8px;scrollbar-width:thin}
  .sw{appearance:none;background:none;border:0;color:var(--muted);font:inherit;font-size:12px;display:grid;justify-items:center;gap:6px;cursor:pointer;flex:0 0 auto;min-width:54px}
  .sw i{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.28);display:block}
  .sw[aria-pressed="true"]{color:var(--paper)}
  .sw[aria-pressed="true"] i{outline:2px solid var(--paper);outline-offset:2px}
  .field{display:flex;flex-direction:column;gap:6px}
  .field input{background:var(--ink);color:var(--paper);border:1px solid var(--line);border-radius:2px;padding:11px 12px;font:inherit;min-height:44px}
  .card{background:var(--panel);border:1px solid var(--line);padding:16px;display:flex;flex-direction:column;gap:14px;backdrop-filter:blur(6px)}

  .adj{border-top:1px solid var(--line);padding-top:10px}
  .adj summary{cursor:pointer;font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);min-height:32px;display:flex;align-items:center}
  .adjrow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:10px;align-items:center;margin:8px 0}
  .adjrow label{font-size:13px;color:var(--paper)}
  .adjrow input[type=range]{width:100%;accent-color:var(--paper);min-height:28px}
  .adj .btn{margin-top:6px;min-height:40px;flex:none;width:100%}
  .toast{position:fixed;left:50%;bottom:max(22px,env(safe-area-inset-bottom));transform:translate(-50%,20px);opacity:0;pointer-events:none;
    background:var(--paper);color:var(--ink);padding:12px 16px;max-width:min(92vw,440px);font-size:14px;line-height:1.45;border-radius:2px;transition:opacity .2s,transform .2s;z-index:80}
  .toast.show{opacity:1;transform:translate(-50%,0)}
  @media (prefers-reduced-motion:reduce){.flashfull.go{animation-name:flashsoft}.wall{transition:none}.rec i{animation:none}.scene{transition-duration:.01s}}
</style>
</head>
<body>
<div class="flashfull" id="flash"></div>
<main class="app">

  <!-- 1. 부스 앞 -->
  <section class="intro" id="intro" aria-label="포토부스 입구">
    <div class="scene" id="scene">
      <!-- 진짜 부스 사진을 쓰려면 이 파일과 같은 폴더에 booth.jpg 를 넣으세요. 있으면 자동으로 배경이 됩니다. -->
      <div class="photo" id="scenePhoto"></div>
      <svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <defs>
          <linearGradient id="room" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ecdcae"/><stop offset="1" stop-color="#c7aa6e"/></linearGradient>
          <linearGradient id="curt" x1="0" y1="0" x2=".5" y2="0" spreadMethod="repeat"><stop offset="0" stop-color="#10152e"/><stop offset=".5" stop-color="#262e57"/><stop offset="1" stop-color="#10152e"/></linearGradient>
          <radialGradient id="glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#ffe7a8" stop-opacity=".5"/><stop offset="1" stop-color="#ffe7a8" stop-opacity="0"/></radialGradient>
          <pattern id="cob" width="26" height="14" patternUnits="userSpaceOnUse"><rect width="26" height="14" fill="#4b4640"/><rect x="1" y="1" width="11" height="5.5" rx="2" fill="#6a645b"/><rect x="14" y="1" width="11" height="5.5" rx="2" fill="#5c564e"/><rect x="7" y="8" width="11" height="5" rx="2" fill="#625c53"/></pattern>
          <pattern id="tile" width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#d9d2c0"/><rect width="5" height="5" fill="#35332e"/><rect x="5" y="5" width="5" height="5" fill="#35332e"/></pattern>
          <filter id="grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" seed="4"/><feColorMatrix type="saturate" values="0"/></filter>
        </defs>
        <!-- 위쪽 건물 벽 -->
        <rect width="400" height="214" fill="#d9cfb9"/>
        <g fill="#e1d8c4" stroke="#b9ad92" stroke-width="2">
          <rect x="14" y="14" width="176" height="76"/><rect x="210" y="14" width="176" height="76"/>
          <rect x="14" y="106" width="74" height="86"/><rect x="214" y="106" width="172" height="86"/>
        </g>
        <rect x="98" y="104" width="70" height="90" fill="#cfc4aa" stroke="#b0a488" stroke-width="2"/>
        <g stroke="#b8ac91" stroke-width="2"><path d="M100 116h66M100 128h66M100 140h66M100 152h66M100 164h66M100 176h66"/></g>
        <rect x="0" y="212" width="400" height="14" fill="#c3b79e"/>
        <rect x="0" y="226" width="400" height="12" fill="#0c1513"/>
        <!-- 짙은 녹색 파사드 -->
        <rect x="0" y="238" width="400" height="490" fill="#1b2a26"/>
        <g fill="#1f302b" stroke="#2f443d" stroke-width="2">
          <rect x="14" y="262" width="104" height="408"/><rect x="282" y="262" width="104" height="408"/>
        </g>
        <g fill="none" stroke="#2a3d37" stroke-width="2"><rect x="26" y="276" width="80" height="380"/><rect x="294" y="276" width="80" height="380"/></g>
        <rect x="0" y="670" width="400" height="58" fill="#16231f"/>
        <!-- 벽 조명 -->
        <circle cx="62" cy="352" r="26" fill="url(#glow)"/>
        <rect x="56" y="340" width="12" height="20" rx="3" fill="#cfc9b4"/>
        <!-- 부스 -->
        <ellipse cx="206" cy="500" rx="150" ry="240" fill="url(#glow)"/>
        <rect x="134" y="270" width="132" height="404" fill="#0b1311"/>
        <rect x="146" y="318" width="108" height="356" fill="#e9e1cf"/>
        <rect x="170" y="276" width="60" height="26" fill="#f5f0e3" stroke="#1d1d1d" stroke-width="1.5"/>
        <rect x="182" y="302" width="3" height="12" fill="#cfc6b0"/><rect x="215" y="302" width="3" height="12" fill="#cfc6b0"/>
        <text x="200" y="295" text-anchor="middle" font-family="Arial Black,Impact,sans-serif" font-weight="900" font-size="12.5" fill="#161616">PHOTOS</text>
        <!-- 왼쪽 사진 진열 -->
        <rect x="150" y="326" width="36" height="214" fill="#f1ead8"/>
        <g id="strips">
          <rect x="155" y="334" width="26" height="42" fill="#2b2b2b"/><circle cx="168" cy="350" r="7" fill="#9a9a9a"/><rect x="159" y="358" width="18" height="12" rx="6" fill="#7e7e7e"/>
          <rect x="155" y="380" width="26" height="42" fill="#2b2b2b"/><circle cx="168" cy="396" r="7" fill="#a5a5a5"/><rect x="159" y="404" width="18" height="12" rx="6" fill="#858585"/>
          <rect x="155" y="426" width="26" height="42" fill="#2b2b2b"/><circle cx="168" cy="442" r="7" fill="#909090"/><rect x="159" y="450" width="18" height="12" rx="6" fill="#777"/>
          <rect x="155" y="472" width="26" height="42" fill="#2b2b2b"/><circle cx="168" cy="488" r="7" fill="#a0a0a0"/><rect x="159" y="496" width="18" height="12" rx="6" fill="#808080"/>
        </g>
        <rect x="150" y="548" width="36" height="126" fill="#e2dbc8"/><rect x="160" y="566" width="16" height="7" fill="#8d6b2f"/>
        <!-- 안쪽 -->
        <rect x="188" y="326" width="66" height="348" fill="url(#room)"/>
        <rect x="224" y="326" width="30" height="334" fill="url(#curt)"/>
        <rect x="188" y="326" width="66" height="10" fill="#fff3c8" opacity=".65"/>
        <ellipse cx="200" cy="630" rx="9" ry="4" fill="#5a3f22"/><rect x="199" y="632" width="2" height="22" fill="#3a2a18"/>
        <rect x="188" y="654" width="66" height="20" fill="url(#tile)"/>
        <rect x="254" y="318" width="6" height="356" fill="#d3cbb8"/>
        <!-- 길 -->
        <rect x="0" y="726" width="400" height="12" fill="#6a4630"/>
        <rect x="0" y="738" width="400" height="62" fill="url(#cob)"/>
        <rect width="400" height="800" filter="url(#grain)" opacity=".16" style="mix-blend-mode:overlay"/>
      </svg>
    </div>
    <button class="enter" id="enterBtn" type="button">커튼 열고 들어가기<small>카메라가 켜져요</small></button>
  </section>

  <!-- 2. 촬영 -->
  <section id="shoot" aria-label="촬영" hidden>
    <div class="app">
      <header>
        <h1>Photo Booth</h1>
        <p class="sub">4 · 6 · 9 cut</p>
      </header>

      <div class="wall" id="wall" data-flash="soft">
        <div class="lamp" id="lamp"></div>
        <div class="stage" id="stage">
          <video id="cam" playsinline muted autoplay></video>
          <canvas id="view" aria-label="카메라 화면"></canvas>
          <div class="count" id="count" aria-live="assertive"></div>
          <div class="rec" id="rec" hidden><i></i>REC</div>
          <p class="notice" id="notice" hidden></p>
        </div>
      </div>

      <div class="slots" id="slots" aria-label="찍은 사진"></div>

      <div class="panel">
        <div class="row">
          <span class="lab">컷 수</span>
          <div class="seg" id="segN">
            <button type="button" data-n="4" aria-pressed="true">4컷</button>
            <button type="button" data-n="6" aria-pressed="false">6컷</button>
            <button type="button" data-n="9" aria-pressed="false">9컷</button>
          </div>
        </div>
        <div class="row">
          <span class="lab">SOFT FLASH</span>
          <div class="seg" id="segFlash">
            <button type="button" data-flash="off" aria-pressed="false">OFF</button>
            <button type="button" data-flash="soft" aria-pressed="true">SOFT</button>
            <button type="button" data-flash="bright" aria-pressed="false">BRIGHT</button>
          </div>
        </div>
        <div class="row">
          <span class="lab">SKIN</span>
          <div class="seg" id="segSkin">
            <button type="button" data-skin="off" aria-pressed="false">OFF</button>
            <button type="button" data-skin="natural" aria-pressed="true">NATURAL</button>
          </div>
        </div>
        <div class="row">
          <span class="lab">PARISIAN SOFT CONTRAST</span>
          <div class="seg" data-segpar>
            <button type="button" data-par="off" aria-pressed="false">OFF</button>
            <button type="button" data-par="on" aria-pressed="true">ON</button>
          </div>
        </div>
        <details class="adj">
          <summary>필터 세부 조절</summary>
          <div id="adjBox"></div>
          <button class="btn" id="adjReset" type="button">기본값으로</button>
        </details>
        <div class="actions">
          <button class="btn primary" id="startBtn" type="button">촬영 시작</button>
          <button class="btn" id="flipBtn" type="button">카메라 전환</button>
        </div>
        <p class="hint">누르면 3초 뒤 첫 컷, 그다음부터 2초 간격으로 자동 촬영돼요. 찍기 직전에 화면 조명이 잠깐 밝아졌다가 돌아와요.</p>
      </div>
    </div>
  </section>

  <!-- 3. 결과 -->
  <section id="result" hidden aria-label="결과">
    <header>
      <h1>Photo Booth</h1>
      <p class="sub">your strip</p>
    </header>
    <div class="print"><canvas id="out" aria-label="완성된 사진"></canvas></div>

    <div class="card">
      <div>
        <div class="lab" style="margin-bottom:4px">A4에 붙여서 꾸미기 (선택)</div>
        <p class="hint" id="bgHint">고르지 않으면 사진만 저장·공유돼요.</p>
        <div class="swatches" id="swatches"></div>
      </div>
      <label class="field" id="footerField" hidden>
        <span class="lab">A4 하단 문구</span>
        <input id="footerText" type="text" maxlength="24" value="PHOTO BOOTH" autocomplete="off">
      </label>
      <div class="row">
        <span class="lab">PARISIAN SOFT CONTRAST</span>
        <div class="seg" data-segpar>
